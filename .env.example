# Names only. Real values live in .env (gitignored) or your host's secret store. Never commit them.
# Comments sit on their own lines: `docker run --env-file` treats an inline "# ..." as part of the value.

# Fine-grained, read-only on the ecosystem repo (Contents, Pull requests, Issues, Actions: read)
GITHUB_TOKEN=
ECOSYSTEM_REPO=Sarah-JaneHarding/infinite-ai-ecosystem
# Same value you set on the GitHub webhook
GITHUB_WEBHOOK_SECRET=
# "true" lets an APPROVED proposal open an issue (needs Issues: write on the token)
OPS_ALLOW_ECOSYSTEM_WRITES=false
# Model Hub (docs/MODEL_HUB.md). Keys live only here. After adding one: restart, then attest it in the hub.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# Pin a model your key can use; changing a model needs a new attestation in the hub
GEMINI_MODEL=
# Routing order, first choice first
OPS_MODEL_ORDER=anthropic,gemini
# Calls per provider per day (counted from the ledger)
OPS_MODEL_DAILY_CALLS=500
# Collections whose contents tools may show a model (de-identified). Empty means counts only. Never the ledger or erasure records.
OPS_MODEL_READABLE_COLLECTIONS=
# Autonomous agents (docs/AUTONOMY.md). Off until set to "on". Needs OPS_USERS. Agents only ever draft; people sign.
OPS_AUTONOMY=
# Platform-wide cap on autonomous runs per day (default 20)
OPS_AUTONOMY_MAX_RUNS_PER_DAY=
# Who may use the platform: comma-separated id:token pairs. Ids are a-z, 0-9, "-". Tokens are 20+ random characters,
# e.g. `openssl rand -hex 24`. The server takes the actor from the token, so approvals cannot be signed as someone else.
# Interim until SSO is decided (OPQ-002). With none set the server only starts on a loopback HOST, in open dev mode.
OPS_USERS=
# Optional roles: comma-separated id:officer. Each id must be in OPS_USERS. When set, only an officer may attest a model provider,
# activate an autonomous order, or decide an erasure request. Unset means everyone signed in may (interim, OPQ-015/019).
OPS_ROLES=
# API requests per address per minute (default 300). Bad tokens are limited to 10 a minute regardless.
OPS_RATE_PER_MINUTE=
# Set to 1 when exactly one reverse proxy sits in front, so limits see the caller's address
OPS_TRUST_PROXY=
# Set to on only when the site is served over HTTPS (adds Strict-Transport-Security)
OPS_HSTS=
# Legacy single shared token (acts as user "operator"). Prefer OPS_USERS.
OPS_API_TOKEN=
# "true" lets the server start with no users on a non-loopback HOST (throwaway local containers only)
OPS_OPEN_DEV=
HOST=127.0.0.1
PORT=3000

# Outbound: send approved artefacts to these exact https hosts (comma separated). Empty = off.
OPS_OUTBOUND_ALLOWLIST=
# Optional: signs each outbound request in the x-ops-signature header.
OPS_OUTBOUND_SECRET=
