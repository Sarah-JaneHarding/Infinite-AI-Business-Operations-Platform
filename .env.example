# Names only. Real values live in .env (gitignored) or your host's secret store. Never commit them.
GITHUB_TOKEN=            # fine-grained, read-only on the ecosystem repo (Contents, Pull requests, Issues, Actions: read)
ECOSYSTEM_REPO=Sarah-JaneHarding/infinite-ai-ecosystem
GITHUB_WEBHOOK_SECRET=   # same value you set on the GitHub webhook
OPS_ALLOW_ECOSYSTEM_WRITES=false   # "true" lets an APPROVED proposal open an issue (needs Issues: write on the token)
GEMINI_API_KEY=          # optional; without it the deterministic local engine is used
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=       # optional; Claude narrative engine. Without it, Gemini or the local engine is used
ANTHROPIC_MODEL=claude-opus-5
OPS_API_TOKEN=           # optional shared secret required in the x-ops-token header
HOST=127.0.0.1
PORT=3000
