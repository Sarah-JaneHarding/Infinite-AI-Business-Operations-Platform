{
  "title": "Privacy Notice (for parents and educators)",
  "blocks": [
    {
      "type": "callout",
      "tone": "warn",
      "text": "Needs review by a South African attorney or the appointed Information Officer before use. This is a drafting outline, not legal advice and not an approved document. The statutes and instruments named are pointers for the reviewer: POPIA (Act 4 of 2013) sections 18 and 34."
    },
    {
      "type": "kv",
