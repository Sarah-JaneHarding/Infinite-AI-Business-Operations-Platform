        [
          "Document ID",
          "lib-privacy-notice"
        ],
        [
          "Version",
          "1.0 (draft)"
        ],
        [
          "Prepared by (role)",
          "[Fill in: role]"
        ],
        [
          "Date",
          "[Fill in: date]"
        ]
      ]
    },
    {
      "type": "h",
      "level": 2,
      "text": "Who is responsible"
    },
    {
      "type": "kv",
      "pairs": [
        [
          "The school (responsible party)",
          "[Fill in: school name and contact]"
        ],
        [
          "The platform provider (operator)",
          "[Fill in: company name and contact]"
        ],
        [
          "Information Officer",
          "[Fill in: name, role, email]"
        ]
      ]
    },
    {
      "type": "h",
      "level": 2,
      "text": "What we collect and why"
    },
    {
      "type": "table",
      "headers": [
        "What",
        "Why",
        "Who sees it"
      ],
      "rows": [
        [
          "Learner name, class and grade",
          "[Fill in: purpose]",
          "[Fill in: roles]"
        ],
        [
          "Educator name and role",
          "[Fill in: purpose]",
          "[Fill in: roles]"
        ],
        [
          "Learner support notes",
          "[Fill in: purpose]",
          "[Fill in: roles]"
        ]
      ]
    },
    {
      "type": "h",
      "level": 2,
      "text": "AI and your child’s information"
    },
    {
      "type": "p",
      "text": "Learner personal information is never put into an AI prompt. It is replaced with codes first. A teacher reviews any AI draft, and nothing that affects a learner is final until a person approves it."
    },
    {
      "type": "h",
      "level": 2,
      "text": "How long we keep it"
    },
    {
      "type": "p",
      "text": "[Fill in: retention periods set by the school; the platform ships none]"
    },
    {
      "type": "h",
      "level": 2,
      "text": "Your rights"
    },
    {
      "type": "ul",
      "items": [
        "Ask what we hold about you or your child.",
        "Ask us to correct it.",
        "Ask us to delete it where the law allows.",
        "Complain to the school’s Information Officer, or to the Information Regulator."
      ]
    },
    {
      "type": "p",
      "text": "Regulator contact: [Fill in: current contact details taken from the Regulator’s website on the day of issue]"
    }
  ],
  "meta": {
