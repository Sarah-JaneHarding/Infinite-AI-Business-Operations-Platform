{
  "title": "Press Release Template",
  "blocks": [
    {
      "type": "callout",
      "tone": "warn",
      "text": "Needs review by the founder, before anything is published before use. This is a drafting outline, not legal advice and not an approved document."
    },
    {
      "type": "kv",
      "pairs": [
        [
          "Document ID",
          "lib-press-release"
        ],
        [
          "Version",
          "1.0 (draft)"
        ],
        [
          "Prepared by (role)",
          "[Fill in: role]"
        ],
        [
          "Date",
          "[Fill in: date]"
        ]
      ]
    },
    {
      "type": "table",
      "headers": [
        "Part",
        "Content"
      ],
      "rows": [
        [
          "Headline",
          "[Fill in: headline]"
        ],
        [
          "Date and place",
          "[Fill in: date, place]"
        ],
        [
          "Lead paragraph",
          "[Fill in: who, what, why now]"
        ],
        [
          "Quote",
          "[Fill in: spoken or written approval from the person quoted]"
        ],
        [
          "About the company",
          "[Fill in: boilerplate]"
        ],
        [
          "Contact",
          "[Fill in: name, email, phone]"
        ]
      ]
    },
    {
      "type": "p",
      "text": "No learner, school or parent is named without their written consent."
    }
  ],
  "meta": {
    "Library ID": "lib-press-release",
    "Kind": "template",
    "Version": "1.0",
    "Status": "DRAFT, not approved for use"
  }
}
