{
  "title": "Knowledge Base Article Template",
  "blocks": [
    {
      "type": "kv",
      "pairs": [
        [
          "Document ID",
          "lib-kb-article"
        ],
        [
          "Version",
          "1.0 (draft)"
        ],
        [
          "Prepared by (role)",
          "[Fill in: role]"
        ],
        [
          "Date",
          "[Fill in: date]"
        ]
      ]
    },
    {
      "type": "table",
      "headers": [
        "Part",
        "Content"
      ],
      "rows": [
        [
          "Title",
          "[Fill in: what the user wants to do]"
        ],
        [
          "Audience",
          "[Fill in: role]"
        ],
        [
          "Steps",
          "[Fill in: numbered, one action each]"
        ],
        [
          "Result",
          "[Fill in: what they should see]"
        ],
        [
          "If it fails",
          "[Fill in: what to try, who to contact]"
        ],
        [
          "Last checked",
          "[Fill in: date]"
        ]
      ]
    }
  ],
  "meta": {
    "Library ID": "lib-kb-article",
    "Kind": "template",
    "Version": "1.0",
    "Status": "DRAFT, not approved for use"
  }
}
