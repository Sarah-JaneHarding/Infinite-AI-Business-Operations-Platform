{
  "title": "Service Level Agreement",
  "blocks": [
    {
      "type": "callout",
      "tone": "warn",
      "text": "Needs review by a South African attorney before use. This is a drafting outline, not legal advice and not an approved document. The statutes and instruments named are pointers for the reviewer: Consumer Protection Act 68 of 2008."
    },
    {
      "type": "kv",
      "pairs": [
        [
          "Document ID",
          "lib-sla"
        ],
        [
          "Version",
          "1.0 (draft)"
        ],
        [
          "Owner (role)",
          "[Fill in: role]"
        ],
        [
          "Approved by (role)",
          "[Fill in: role]"
        ],
        [
          "Effective date",
          "[Fill in: date]"
        ],
        [
          "Next review",
          "[Fill in: date]"
        ]
      ]
    },
    {
      "type": "callout",
      "tone": "warn",
      "text": "Do not promise a response time or an availability figure the company cannot meet. Decide the numbers with the on-call plan and the hosting provider’s own commitments, then write them in."
    },
    {
      "type": "h",
      "level": 2,
      "text": "Support"
    },
    {
      "type": "kv",
      "pairs": [
        [
          "Support hours",
          "[Fill in: days and times, South African Standard Time]"
        ],
        [
          "Channels",
          "[Fill in: email, portal, phone]"
        ],
        [
          "Language",
          "[Fill in: languages supported]"
        ]
      ]
    },
    {
      "type": "h",
      "level": 2,
      "text": "Severity and targets"
    },
    {
      "type": "table",
      "headers": [
        "Severity",
        "Meaning",
        "First response",
        "Target resolution"
      ],
      "rows": [
        [
          "1 Critical",
          "Platform unusable for a school",
          "[Fill in: time]",
          "[Fill in: time]"
        ],
        [
          "2 High",
          "Major feature unusable, workaround exists",
          "[Fill in: time]",
          "[Fill in: time]"
        ],
        [
          "3 Normal",
          "Fault with limited impact",
          "[Fill in: time]",
          "[Fill in: time]"
        ],
        [
          "4 Low",
          "Question or small request",
          "[Fill in: time]",
          "[Fill in: time]"
        ]
      ]
    },
    {
      "type": "h",
      "level": 2,
      "text": "Availability"
    },
    {
      "type": "kv",
      "pairs": [
        [
          "Availability target",
          "[Fill in: percentage the company can actually meet]"
        ],
        [
          "Measurement window",
          "[Fill in: monthly or other]"
        ],
        [
          "Exclusions",
          "[Fill in: planned maintenance, school-side faults, force majeure]"
        ]
      ]
    },
    {
      "type": "h",
      "level": 2,
      "text": "Remedies"
    },
    {
      "type": "p",
      "text": "[Fill in: service credit or other remedy; counsel to decide]"
    },
    {
      "type": "h",
      "level": 2,
      "text": "Reporting"
    },
    {
      "type": "p",
      "text": "A monthly service report goes to the school using lib-sla-report."
    }
  ],
  "meta": {
